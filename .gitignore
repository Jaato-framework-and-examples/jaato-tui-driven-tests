# Python
__pycache__/
*.pyc
*.egg-info/

# Local env holds a LIVE provider credential — never commit it.
# The committed template is .env.example; `cp .env.example .env` and fill in.
.env
!.env.example

# IDE / editor caches
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Per-session jaato runtime state — not source.
# (Sessions, logs, cache get re-created per run; no need to track.)
.jaato/sessions/
.jaato/logs/
.jaato/cache/
.jaato/vision/
.jaato/waypoints.json
.jaato/.artifact_tracker.json

# Template-plugin artifacts.  Cross-tenant leak observed 2026-05-08:
# kb-enablement-2.0's cascade wrote java-codegen template content into
# this workspace's .jaato/templates/ during a harness run.  Template
# plugin path doesn't go through the workspace_root ContextVar fix;
# tracked as a separate backlog item.  Until fixed, treat these as
# untrustworthy and don't commit.
.jaato/templates/

# Auth tokens persisted by provider plugins — never commit.
.jaato/*_auth.json

# Audit sidecars + auto-generated walkthrough sections written by
# the manual_writer reactor.  Both are derived from the agent's
# typed payload per run; only the hand-written manual/00-intro.md
# is source.
manual/.payloads/
manual/20-walkthrough-*.md

# Build outputs — the assembled intermediate markdown is regenerated per
# run (just `manual/*.md` concatenated with page breaks), but the final
# PDF is committed so reviewers can read the manual without rebuilding.
build/*.md
.jaato
