# jaato-tui-driven-tests workspace — sane minimal env.
# Loaded by the TUI client (--env-file defaults to ./.env) and forwarded
# to the daemon via env_file on session.new.
#
# ── Credentials resolve via pass:// (jaato-premium ≥0.1.25). ──────────
# The framework's _resolve_secret_uri (shared/plugins/subagent/config.py)
# matches `pass://path` values and runs `pass show path` at session-init
# to substitute the literal credential.  Setup:
#
#     pass insert jaato/openrouter/api-key   # paste the key
#     pass show jaato/openrouter/api-key     # once, to prime gpg-agent
#                                            # (daemon is headless — has
#                                            # no TTY to unlock GPG)
#
# Multi-line entries: only the first line is returned.  Use one secret
# per pass entry.  See reference_pass_resolver_in_premium memory for
# gotchas (gpg-agent TTL, no in-process cache, etc).
# ──────────────────────────────────────────────────────────────────────

# Provider — openrouter with FREE-tier NVIDIA Nemotron 3 Super.
# Switched to openrouter free-tier on 2026-05-11 for the harness's
# self-documenting workflow: zero per-call cost lets us iterate
# on the documenter/manual_writer prompts without credit pressure.
#
# openai/gpt-oss-20b:free
#   - 262K context window
#   - $0 prompt + $0 completion cost (per openrouter catalog)
#   - 120B params (MoE 12B active) — strong instruction-following
#
# OpenRouter has no per-key concurrency limit (vs zhipuai=1), so
# parallel harnesses + documenter-driving-TUI can run concurrent.
#
# Cost-comparison note: earlier openrouter use (May 8) was on
# anthropic models which burned credits fast.  Free Nemotron is the
# opposite tradeoff — zero credit burn, slightly less capable than
# Claude/GPT-tier but plenty for documentation generation.
JAATO_PROVIDER=openrouter
# Framework-level cross-provider default.  The harness's three profiles
# (documenter, manual_writer, tiered_test) all set ``model:`` explicitly
# so this is unused in practice — kept only as a fallback for any future
# profile that doesn't pin a model.
MODEL_NAME=openai/gpt-oss-20b:free
JAATO_OPENROUTER_API_KEY=pass://jaato/openrouter/api-key

# NOTE (2026-06-26): removed the dead `JAATO_REDACTION_ENABLED=off` flag.
# `jaato-scaffold explain env` + a framework grep confirm nothing reads it
# anymore — PII pseudonymization is now an opt-in premium *plugin* surface
# (the four-seat redaction design), gated by plugin presence/config, not by
# an env var.  This workspace's profiles load no pseudonymization plugin, so
# there is no Presidio overhead to disable here in the first place.

# GC: budget plugin in CONTINUOUS-target mode.
# - JAATO_GC_PRESSURE=0  → continuous mode (GC after every turn if
#                         usage > target_percent)
# - JAATO_GC_TARGET=60.0 → continuous-mode trigger AND post-GC target
# - JAATO_GC_THRESHOLD=80.0 → threshold-mode trigger (unused while
#                            pressure=0)
JAATO_GC_PRESSURE=0
JAATO_GC_TARGET=60.0
JAATO_GC_THRESHOLD=80.0
