# jaato-tui-driven-tests workspace — sane minimal env
# Loaded by the TUI client (--env-file defaults to ./.env) and forwarded
# to the daemon via env_file on session.new.

# Provider — uses zhipuai (known-working auth on this host;
# ~/.jaato/zhipuai_auth.json present). Switch to anthropic / claude_cli
# / openrouter / etc. if a different provider is preferred AND that
# provider's auth has been run on this host.
JAATO_PROVIDER=zhipuai
MODEL_NAME=glm-5-turbo

# GC: budget plugin in CONTINUOUS-target mode.
# Read by shared/plugins/gc/base.py at GCConfig construction time.
#
# - JAATO_GC_PRESSURE=0  → enables continuous mode (GC runs after every
#                         turn if usage > target_percent). Non-zero values
#                         use threshold mode instead (GC triggers when
#                         usage >= threshold, runs once, returns to idle).
# - JAATO_GC_TARGET=60.0 → continuous-mode trigger threshold AND post-GC
#                         usage target. GC keeps the context window at or
#                         below this percentage.
# - JAATO_GC_THRESHOLD=80.0 → threshold-mode trigger (kept for completeness;
#                            unused while pressure=0 selects continuous).
#
# Continuous mode is more aggressive than threshold mode: it actively
# prunes throughout the session rather than waiting for context pressure.
# Useful for long-running interactive sessions where steady-state context
# size matters more than per-turn turnaround latency.
JAATO_GC_PRESSURE=0
JAATO_GC_TARGET=60.0
JAATO_GC_THRESHOLD=80.0
